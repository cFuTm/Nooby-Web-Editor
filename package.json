{
  "name": "canvas-web-editor",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "dist": "npm run build && electron-builder --win nsis portable --x64"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "electron": "36.3.1",
    "electron-builder": "26.0.12",
    "tsx": "4.19.4",
    "playwright": "1.52.0"
  },
  "build": {
    "appId": "studio.canvas.editor",
    "productName": "Canvas Web Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Canvas-Web-Editor-${version}-Setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Canvas-Web-Editor-${version}-Portable-${arch}.${ext}"
    }
  },
  "description": "Offline fixed-canvas visual website editor",
  "author": "Canvas Web Editor"
}
